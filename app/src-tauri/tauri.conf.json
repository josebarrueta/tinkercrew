{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinkeroo",
  "version": "0.1.0",
  "identifier": "com.tinkercrew.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Tinkeroo",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "FamilyGame",
    "resources": {
      "../../docs/release/third-party/DEPENDENCY_INVENTORY.json": "third-party/DEPENDENCY_INVENTORY.json",
      "../../docs/release/third-party/DEPENDENCY_NOTICES.txt": "third-party/DEPENDENCY_NOTICES.txt"
    },
    "shortDescription": "Build. Code. Imagine. Together.",
    "longDescription": "A local-first cooperative maker game for one family crew and an Arduino UNO Q.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
